# A hostname you own, with DNS pointing to the server (no https:// prefix).
CLIP_DOMAIN=clips.example.com
CLIP_USERNAME=joshua
# Replace with the output of `docker run --rm -it caddy:2-alpine caddy hash-password`.
# Keep the hash in SINGLE quotes: Compose must not expand its dollar signs.
CLIP_PASSWORD_HASH='replace-with-generated-bcrypt-hash'
